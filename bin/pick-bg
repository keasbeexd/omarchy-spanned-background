#!/usr/bin/bash
# Run the omarchy background picker under a deadline, then hand the chosen
# path to omarchy-theme-bg-set. This is the same pair of commands the stock
# plugin invokes on a desktop double-click; wrapping them here gives us:
#
#   * an absolute deadline (`timeout -k`) so a hung picker cannot pin the
#     Quickshell process,
#   * teardown that reaches the whole picker subtree: `timeout` puts itself
#     and everything it starts into a fresh process group and forwards a
#     TERM it receives to that group, and this wrapper forwards its own TERM
#     to `timeout` (see the trap below),
#   * a producer-side byte cap on the picker's output,
#   * strict validation of the returned path before it becomes an argv element
#     of the setter.

set -uo pipefail
umask 077

MAX=4096

# We deliberately let the picker inherit our environment (it draws UI and
# needs DISPLAY / WAYLAND_DISPLAY / DBUS_SESSION_BUS_ADDRESS). PATH is
# reset to the standard system search paths so a hostile prepend cannot
# shadow the omarchy tools during the call.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Byte length, not character length: in a UTF-8 locale `${#v}` counts
# characters, so a 4097-byte multibyte result would pass a `-le 4096` check
# and the truncation would go unnoticed.
bytelen() { local LC_ALL=C; printf '%s' "${#1}"; }

# The picker runs in a process substitution so this shell is never blocked in
# a foreground wait: bash defers traps until a foreground command finishes,
# but `wait` is interrupted by them. Its output is a single short line, well
# inside the pipe buffer, so nothing stalls while we wait for it to exit.
exec {out}< <(exec /usr/bin/timeout -k 2 60 omarchy-theme-bg-switcher 2>/dev/null)
picker=$!
trap '/usr/bin/kill -TERM "$picker" 2>/dev/null; exit 143' TERM INT HUP
wait "$picker"
rc=$?
trap - TERM INT HUP

# rc 124 => the picker was killed by the deadline; rc 130 => the user hit
# ^C on the picker; neither is an error worth reporting to the shell log.
case "$rc" in
  0) : ;;
  124|130) exit 0 ;;
  *) exit "$rc" ;;
esac

# The writer has exited, so this read ends at EOF; `head` reads MAX + 1 so
# an oversized answer is detected below rather than silently truncated.
sel=$(/usr/bin/head -c $((MAX + 1)) <&"$out")
exec {out}<&-
if [ "$(bytelen "$sel")" -gt "$MAX" ]; then
  echo "spanned-background/pick-bg: picker output exceeded ${MAX} bytes" >&2
  exit 1
fi

# Trim exactly one trailing newline (the picker prints one), then reject
# anything that still contains a control character. That leaves paths that
# look like paths and rejects paths that look like shell strings.
sel="${sel%$'\n'}"
[ -n "$sel" ] || exit 0
# `[[:cntrl:]]` rather than a hand-rolled `[$'\x00'-$'\x1f'$'\x7f']`: bash
# truncates strings at NUL, so `$'\x00'` becomes empty and the bracket
# collapses to `[-\x1f\x7f]`, matching literal `-` in any legitimate path.
case "$sel" in
  *[[:cntrl:]]*)
    echo "spanned-background/pick-bg: picker output rejected (control character)" >&2
    exit 1 ;;
esac

# omarchy-theme-bg-set takes the path as its single positional argument.
# The `--` separator prevents a leading `-` from being read as an option.
# `exec` makes `timeout` this process, so a TERM from the shell lands on it
# and is forwarded to the setter's whole process group.
exec /usr/bin/timeout -k 2 30 omarchy-theme-bg-set -- "$sel"
