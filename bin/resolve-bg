#!/usr/bin/bash
# Bounded resolve of ~/.local/state/omarchy/current/background to the wallpaper
# file it points at.
#
# The link is expected: omarchy maintains it and updates the target on every
# wallpaper change. `readlink -f` follows the whole chain, which is what we
# want here. The output is capped at 4096 bytes and the resolved target is
# validated as a regular file the current user owns before it is printed.
# Anything else prints nothing (exit 0) so the caller keeps its last known
# good value rather than assigning something bogus to Image.source.

set -u
: "${HOME:?HOME is not set}"

link="$HOME/.local/state/omarchy/current/background"

# `head -c 4097` caps the output at the producer. If readlink is somehow
# induced to print more (a truly pathological chain of symlinks), the length
# check below rejects the whole result.
path=$(/usr/bin/readlink -f -- "$link" 2>/dev/null \
         | /usr/bin/head -c 4097) || exit 0
[ "${#path}" -le 4096 ] || exit 0
[ -n "$path" ] || exit 0

# Must be an absolute path; no scheme URLs, no relative paths.
case "$path" in
  /*) ;;
  *)  exit 0 ;;
esac

# Reject control characters; a real filename does not contain them and they
# would confuse both the URL layer and any downstream logs.
case "$path" in
  *[$'\x00'-$'\x1f'$'\x7f']*) exit 0 ;;
esac

# `readlink -f` already resolved, so a lingering `-L` here means the target
# is itself a symlink somehow; refuse. `-f` follows, but at this point the
# path is canonical so it just asserts "regular file".
if [ -L "$path" ]; then exit 0; fi
if [ ! -f "$path" ]; then exit 0; fi
if [ "$(/usr/bin/stat -Lc %u -- "$path" 2>/dev/null)" != "$(/usr/bin/id -u)" ]; then
  exit 0
fi

printf '%s' "$path"
